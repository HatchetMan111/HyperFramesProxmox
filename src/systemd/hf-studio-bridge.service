[Unit]
Description=socat-Brücke Hyperframes-Studio ins LAN (:3100 -> :3002)
After=network-online.target hf-studio.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/socat TCP-LISTEN:3100,fork,reuseaddr,bind=0.0.0.0 TCP:127.0.0.1:3002
Restart=always
RestartSec=3

[Install]
WantedBy=hyperframes-suite.target
