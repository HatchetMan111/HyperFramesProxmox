[Unit]
Description=Hyperframes Job-UI (Prompt zu Video)
After=network-online.target omniroute.service
Wants=network-online.target

[Service]
User=hyperframes
WorkingDirectory=/opt/hyperframes
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/opt/hyperframes/.env
ExecStart=/usr/bin/node /opt/hyperframes/job-server.js
Restart=always
RestartSec=5

[Install]
WantedBy=hyperframes-suite.target
